---
import type { Tool } from '../lib/products';
import CodeBlock from './CodeBlock.astro';

interface Props {
  tool: Tool;
}
const { tool } = Astro.props;
const lab = tool.status === 'lab';
const comments: string[] = 'comment_lines' in tool ? tool.comment_lines : [tool.comment];
const lines = [...comments.map((c) => `# ${c}`), ...tool.commands];
const copyLabel = `Copy ${tool.name} ${tool.commands.length > 1 ? 'commands' : 'command'}`;
---

<article id={tool.id} class:list={['card', { 'card--lab': lab }]}>
  <div class="tool__head">
    <div class="tool__title">
      <h3 class="tool__name"><a href={`/${tool.id}/`}>{tool.name}</a></h3>
      <p class="tool__exp">{tool.expansion}</p>
    </div>
    <span class:list={['badge', { 'badge--lab': lab }]}>{tool.badge}</span>
  </div>

  <ul class="chips" aria-label="Interfaces">
    {tool.interfaces.map((i) => <li>{i}</li>)}
  </ul>

  <p class="card__desc">{tool.description}</p>

  <CodeBlock lines={lines} label={copyLabel} />

  <div class="tool__links mono">
    {
      tool.links.map((l, i) => (
        <a href={l.href} class:list={['hit', i === 0 ? 'repo' : 'muted']}>
          {l.label} ↗
        </a>
      ))
    }
  </div>
</article>

<style>
  .card--lab {
    background: transparent;
    border: 1px dashed var(--line-2);
  }
  .tool__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 16px;
  }
  .tool__title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 14px;
  }
  .tool__name {
    font-family: var(--font-mono);
    font-size: 30px;
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--accent-lg);
  }
  .card--lab .tool__name { color: var(--fg-2); }
  /* The name links to the tool's page; padding grows the hit area to 44px without moving the layout. */
  .tool__name a {
    display: inline-block;
    padding: 4px 0;
    margin: -4px 0;
    color: inherit;
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
  }
  .tool__name a:hover { text-decoration-line: underline; }
  .tool__exp {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--muted);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: 11.5px;
  }
  .chips li {
    padding: 3px 9px;
    border-radius: var(--radius-chip);
    background: var(--chip);
    color: var(--fg-2);
  }

  .tool__links {
    margin-top: auto;
    display: flex;
    flex-wrap: wrap;
    gap: 0 24px;
    font-size: 12.5px;
  }
  .repo { color: var(--fg); text-underline-offset: 3px; }
  .repo:hover { text-decoration: underline; }
  .tool__links .muted:hover { color: var(--fg); }
</style>
