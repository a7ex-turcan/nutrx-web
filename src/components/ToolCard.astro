---
import type { Tool } from '../lib/products';

interface Props {
  tool: Tool;
}
const { tool } = Astro.props;
const lab = tool.status === 'lab';
const comments: string[] = 'comment_lines' in tool ? tool.comment_lines : [tool.comment];
const commands: string[] = tool.commands;
const copyLabel = `Copy ${tool.name} ${commands.length > 1 ? 'commands' : 'command'}`;
---

<article id={tool.id} class:list={['card', { 'card--lab': lab }]}>
  <div class="tool__head">
    <div class="tool__title">
      <h3 class="tool__name">{tool.name}</h3>
      <p class="tool__exp">{tool.expansion}</p>
    </div>
    <span class:list={['badge', { 'badge--lab': lab }]}>{tool.badge}</span>
  </div>

  <ul class="chips" aria-label="Interfaces">
    {tool.interfaces.map((i) => <li>{i}</li>)}
  </ul>

  <p class="card__desc">{tool.description}</p>

  <div class="code" data-code>
    <div class:list={['code__scroll', { 'code__scroll--copy': commands.length > 0 }]}>
      {comments.map((c) => <div class="muted"># {c}</div>)}
      {commands.map((c) => (
        <div>
          <span class="accent" aria-hidden="true">$</span> <span data-cmd>{c}</span>
        </div>
      ))}
    </div>
    {
      commands.length > 0 && (
        <button type="button" class="copy" aria-label={copyLabel} data-copy>
          <svg class="copy__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="9" y="9" width="12" height="12" rx="2" />
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
          </svg>
          <svg class="copy__done" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 6 9 17l-5-5" />
          </svg>
        </button>
      )
    }
  </div>

  <div class="tool__links mono">
    {
      tool.links.map((l, i) => (
        <a href={l.href} class:list={['hit', i === 0 ? 'repo' : 'muted']}>
          {l.label} ↗
        </a>
      ))
    }
  </div>
</article>

<style>
  .card--lab {
    background: transparent;
    border: 1px dashed var(--line-2);
  }
  .tool__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 16px;
  }
  .tool__title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 14px;
  }
  .tool__name {
    font-family: var(--font-mono);
    font-size: 30px;
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--accent-lg);
  }
  .card--lab .tool__name { color: var(--fg-2); }
  .tool__exp {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--muted);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: 11.5px;
  }
  .chips li {
    padding: 3px 9px;
    border-radius: var(--radius-chip);
    background: var(--chip);
    color: var(--fg-2);
  }

  .code {
    position: relative;
    background: var(--code);
    border: 1px solid var(--line);
    border-radius: var(--radius-code);
  }
  .code__scroll {
    overflow-x: auto;
    padding: 14px 16px;
    font-family: var(--font-mono);
    font-size: 12.5px;
    line-height: 1.8;
    white-space: nowrap;
  }
  .code__scroll--copy { padding-right: 56px; }
  .copy {
    position: absolute;
    top: 4px;
    right: 4px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: 8px;
    background: var(--code);
    color: var(--muted);
    cursor: pointer;
    transition: color 0.15s ease;
  }
  .copy:hover { color: var(--fg); }
  .copy__done { display: none; }
  .copy:global(.is-copied) .copy__icon { display: none; }
  .copy:global(.is-copied) .copy__done { display: block; color: var(--accent); }

  .tool__links {
    margin-top: auto;
    display: flex;
    flex-wrap: wrap;
    gap: 0 24px;
    font-size: 12.5px;
  }
  .repo { color: var(--fg); text-underline-offset: 3px; }
  .repo:hover { text-decoration: underline; }
  .tool__links .muted:hover { color: var(--fg); }
</style>
