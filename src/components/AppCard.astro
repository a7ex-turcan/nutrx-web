---
import type { App } from '../lib/products';

interface Props {
  app: App;
}
const { app } = Astro.props;
const soon = app.status === 'soon';

const nutrients = [
  { name: 'Vitamin D', value: '400 / 1000 IU', pct: 40 },
  { name: 'Magnesium', value: '350 / 350 mg · hit', pct: 100, state: 'ok' },
  { name: 'Caffeine', value: '280 / 200 mg · over', pct: 100, state: 'over' },
  { name: 'Omega‑3', value: '1.5 / 2 g', pct: 75 },
];
---

<article id={app.id} class="card app">
  <div class="app__head">
    <div class="app__id">
      <img class="app__icon" src={app.icon} alt="" width="60" height="60" loading="lazy" decoding="async" />
      <div class="app__title">
        <h3>{app.name}</h3>
        <p class="mono muted">{app.platforms}</p>
      </div>
    </div>
    <span class:list={['badge', { 'badge--lab': soon }]}>{app.badge}</span>
  </div>

  {
    app.id === 'nutrx' && (
      <div class="screen today" aria-hidden="true">
        <div class="today__head">
          <span class="today__title">Today</span>
          <span class="today__date">Mon, 16 Mar</span>
        </div>
        {nutrients.map((n) => (
          <div class:list={['nutrient', n.state && `is-${n.state}`]}>
            <div class="nutrient__row">
              <span>{n.name}</span>
              <span class="nutrient__value">{n.value}</span>
            </div>
            <div class="nutrient__track">
              <div class="nutrient__bar" style={`width: ${n.pct}%`} />
            </div>
          </div>
        ))}
      </div>
    )
  }

  {
    app.id === 'softfill' && (
      <div class="screen meadow" aria-hidden="true">
        <svg viewBox="0 0 400 190">
          <rect width="400" height="190" fill="#E6EEF5" />
          <circle cx="316" cy="58" r="30" fill="#F6D27A" stroke="#2A2B31" stroke-width="2.5" />
          <path d="M0 118 C 70 86, 150 92, 220 118 S 350 140, 400 112 L 400 190 L 0 190 Z" fill="#B9DAA8" stroke="#2A2B31" stroke-width="2.5" />
          <path d="M0 156 C 90 132, 190 140, 270 160 S 370 170, 400 156 L 400 190 L 0 190 Z" fill="#FFFFFF" stroke="#2A2B31" stroke-width="2.5" />
          <circle cx="92" cy="150" r="9" fill="#F2A3B6" stroke="#2A2B31" stroke-width="2" />
          <circle cx="132" cy="160" r="7" fill="#FFFFFF" stroke="#2A2B31" stroke-width="2" />
          <circle cx="236" cy="152" r="8" fill="#FFFFFF" stroke="#2A2B31" stroke-width="2" />
          <path d="M60 40 q 14 -12 28 0 q 14 -12 28 0" fill="none" stroke="#2A2B31" stroke-width="2.5" stroke-linecap="round" />
        </svg>
        <div class="meadow__bar">
          <span>
            <span class="meadow__name">Sunny Meadow</span>
            <span class="meadow__progress"> · 44 of 55 colored</span>
          </span>
          <span class="segmented">
            <span class="is-on">Fill</span>
            <span>Draw</span>
          </span>
        </div>
      </div>
    )
  }

  <p class="card__desc">{app.description}</p>

  <div class="app__actions">
    {
      app.links.map((l) => (
        <a href={l.href} class={l.kind === 'primary' ? 'visit' : 'store hit'}>
          {l.label}
        </a>
      ))
    }
  </div>
</article>

<style>
  .app { gap: 22px; }
  .app__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 16px;
  }
  .app__id {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .app__icon {
    flex: none;
    width: 60px;
    height: 60px;
    border-radius: 14px;
    object-fit: cover;
  }
  .app__title {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .app__title h3 {
    font-size: 30px;
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }
  .app__title p { font-size: 12px; }

  .screen {
    background: var(--screen);
    color: var(--screen-fg);
    border-radius: var(--radius-screen);
    font-size: 14px;
  }

  /* nutrx "Today" preview */
  .today {
    padding: 20px 22px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .today__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }
  .today__title { font-weight: 700; font-size: 16px; }
  .today__date { color: var(--screen-muted); font-size: 13px; }
  .nutrient {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .nutrient__row {
    display: flex;
    justify-content: space-between;
    gap: 12px;
  }
  .nutrient__value {
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--screen-muted);
  }
  .nutrient__track {
    height: 6px;
    border-radius: 3px;
    background: var(--screen-track);
  }
  .nutrient__bar {
    height: 6px;
    border-radius: 3px;
    background: var(--screen-fg);
  }
  .is-ok .nutrient__value { color: var(--status-ok); }
  .is-ok .nutrient__bar { background: var(--status-ok); }
  .is-over .nutrient__value { color: var(--status-over); }
  .is-over .nutrient__bar { background: var(--status-over-bar); }

  /* Softfill meadow preview */
  .meadow {
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .meadow svg { width: 100%; height: auto; }
  .meadow__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 14px 18px;
  }
  .meadow__name { font-weight: 700; }
  .meadow__progress { color: var(--screen-muted); }
  .segmented {
    display: inline-flex;
    padding: 3px;
    border-radius: var(--radius-pill);
    background: var(--screen-track);
    font-size: 13px;
  }
  .segmented span {
    padding: 3px 12px;
    color: var(--screen-muted);
  }
  .segmented .is-on {
    border-radius: var(--radius-pill);
    background: var(--screen-fg);
    color: var(--screen);
    font-weight: 600;
  }

  .app__actions {
    margin-top: auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 20px;
  }
  .visit {
    display: inline-flex;
    align-items: center;
    min-height: 46px;
    padding: 0 20px;
    border-radius: var(--radius-button);
    background: var(--fg);
    color: var(--bg);
    font-weight: 600;
    font-size: 15px;
    transition: opacity 0.15s ease;
  }
  .visit:hover { opacity: 0.9; }
  .store {
    color: var(--fg);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .store:hover { color: var(--accent); }
</style>
