          {loads.map((l) => (
            <span class="lift__week">
              <span class:list={['lift__bar', { 'is-deload': l.deload, 'is-next': l.next }]} style={`height: ${l.h}px`} />
              <span class="lift__wk">{l.label}</span>
            </span>
          ))}
        </div>
      </div>
    )
  }

  <p class="card__desc">{app.description}</p>

  {
    work && (
      <ul class="chips" aria-label="Built with">
        {work.stack.map((s) => <li>{s}</li>)}
      </ul>
    )
  }

  <div class="app__actions">
    {
      app.links.map((l) => (
        <a href={l.href} class={l.kind === 'primary' ? 'visit' : 'store hit'}>
          {l.label}
        </a>
      ))
    }
  </div>
</article>

