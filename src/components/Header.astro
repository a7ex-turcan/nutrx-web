---
import { site } from '../lib/products';
const home = Astro.url.pathname === '/';
---

<header class="header">
  <a href={home ? '#top' : '/'} class="wordmark hit">
    <span class="accent">~/</span><span>nutrx-labs</span><span class="cursor" aria-hidden="true"></span>
  </a>
  <div class="header__right">
    <nav aria-label="Primary" class="nav mono">
      <a href="/#tools" class="hit link-hover">tools/</a>
      <a href="/#apps" class="hit link-hover">apps/</a>
      <a href={site.links.github} class="hit link-hover">github ↗</a>
    </nav>
    <button type="button" class="theme-toggle" aria-label="Switch between light and dark theme" data-theme-toggle>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <circle cx="12" cy="12" r="9"></circle>
        <path d="M12 3a9 9 0 0 1 0 18z" fill="currentColor" stroke="none"></path>
      </svg>
    </button>
  </div>
</header>

<script>
  import { toggleTheme } from '../lib/theme';

  /* Theme toggle: system preference by default, the visitor's choice wins and is remembered. */
  document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => toggleTheme());
</script>

<style>
  .header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 4px 24px;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
  }
  .wordmark {
    gap: 2px;
    color: var(--fg);
    font-family: var(--font-mono);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .wordmark .cursor {
    width: 9px;
    height: 17px;
    margin-left: 6px;
  }
  .header__right {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 12px;
  }
  .nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0 24px;
    font-size: 13px;
  }
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius-button);
    background: transparent;
    color: var(--fg);
    cursor: pointer;
    transition: border-color 0.15s ease;
  }
  .theme-toggle:hover { border-color: var(--line-2); }
</style>
